# ==============================================================================
# Polaris - 環境変数設定テンプレート (.env.example)
# ==============================================================================
# このファイルをコピーして `.env` を作成し、必要に応じて設定値を変更してください。
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# データベース設定 (PostgreSQL 17)
# ------------------------------------------------------------------------------
POSTGRES_USER=polaris
POSTGRES_PASSWORD=polaris
POSTGRES_DB=polaris
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 開発用メールサーバー (Mailpit)
# ------------------------------------------------------------------------------
# ブラウザで受信メールを確認するWeb UIポート
MAILPIT_UI_PORT=8025
# アプリケーションから送信されるSMTPポート
MAILPIT_SMTP_PORT=1025

# ------------------------------------------------------------------------------
# バックエンド API (Go)
# ------------------------------------------------------------------------------
API_PORT=8080
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGIN=http://localhost:3000

# 内部データ暗号化キー (AES-256-GCM用 32バイト / 32文字の半角英数字)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# 初回自動管理者設定 (任意: 空欄の場合はブラウザで http://localhost:3000/setup から初期登録)
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=
INIT_ADMIN_NAME=System Admin

# Google OAuth 2.0 連携 (任意: Googleログインを利用する場合のみ設定)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Firebase Web Push / FCM 連携 (任意: プッシュ通知を利用する場合のみ設定)
FIREBASE_CREDENTIALS_FILE=

# ------------------------------------------------------------------------------
# フロントエンド Web (Nuxt 3 SPA)
# ------------------------------------------------------------------------------
WEB_PORT=3000
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Firebase クライアント設定 (任意: プッシュ通知受信用)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_VAPID_KEY=

